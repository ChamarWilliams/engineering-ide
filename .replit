run = "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000"
modules = ["nodejs-22", "python-3.12", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["gcc", "gdb", "jdk21", "lua5_4", "rustc", "go"]

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "pip install -r requirements.txt"]
run = ["sh", "-c", "EIDE_TERMINAL=off EIDE_MULTIUSER=1 python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn backend.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
